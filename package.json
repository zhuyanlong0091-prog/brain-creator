{
  "name": "brain-creator",
  "version": "2.1.1",
  "description": "Requirement-driven, agent-native testing for Claude Code and Codex.",
  "homepage": "https://zhuyanlong0091-prog.github.io/brain-creator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuyanlong0091-prog/brain-creator.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "brain-creator": "dist/cli/brainCreator.js",
    "brain-creator-mcp": "dist/cli/brainCreatorMcp.js",
    "brain-creator-doctor": "dist/cli/doctor.js",
    "brain-creator-install-assets": "dist/cli/installAssets.js",
    "brain-creator-write-mcp-config": "dist/cli/writeMcpConfig.js",
    "brain-creator-install-codex-plugin": "dist/cli/installCodexPlugin.js"
  },
  "files": [
    "dist/",
    "skills/",
    ".claude/agents/",
    "plugin/",
    "plugins/brain-creator/",
    ".agents/plugins/marketplace.json",
    "playwright.config.ts",
    "docs/**/*.md",
    "docs/llms.txt",
    "docs/public/brain-creator-mark.png",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "mcp": "npm run build && node dist/cli/brainCreatorMcp.js",
    "dev:mcp": "node --loader ts-node/esm src/mcp/server.ts",
    "doctor": "npm run build && node dist/cli/doctor.js",
    "init-agents": "npx playwright init-agents --loop=claude",
    "verify:live-claude-chain": "node --loader ts-node/esm scripts/liveClaudeChainSmoke.ts",
    "verify:live-agent-artifacts": "node --loader ts-node/esm scripts/liveAgentArtifactSmoke.ts",
    "verify:live-mcp-workflow": "node --loader ts-node/esm scripts/liveMcpWorkflowSmoke.ts",
    "verify:live-claude-skill-workflow": "node --loader ts-node/esm scripts/liveClaudeSkillWorkflowSmoke.ts",
    "verify:live-session-resume-workflow": "node --loader ts-node/esm scripts/liveSessionResumeWorkflowSmoke.ts",
    "verify:host-agent-chain": "node --loader ts-node/esm scripts/hostAgentChainSmoke.ts",
    "verify:host-agent-document-suite": "node --loader ts-node/esm scripts/hostAgentDocumentSuiteSmoke.ts",
    "verify:codex-native-entry": "node --loader ts-node/esm scripts/codexNativeEntrySmoke.ts",
    "verify:codex-plugin-install": "node --loader ts-node/esm scripts/codexPluginInstallSmoke.ts",
    "verify:installed-mcp": "node --loader ts-node/esm scripts/verifyInstalledMcpSmoke.ts",
    "verify:requirement-eval": "node --loader ts-node/esm scripts/requirementEval.ts",
    "verify:autonomy-baseline": "node --loader ts-node/esm scripts/autonomyBaseline.ts",
    "verify:historical-diagnosis-eval": "node --loader ts-node/esm scripts/historicalDiagnosisEval.ts",
    "verify:package-install": "node --loader ts-node/esm scripts/verifyPackageInstallSmoke.ts",
    "verify:package-contents": "node --loader ts-node/esm scripts/verifyPackageContents.ts",
    "verify:repository-hygiene": "node --loader ts-node/esm scripts/verifyRepositoryHygiene.ts",
    "release:check": "node --loader ts-node/esm scripts/releaseReadiness.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@playwright/test": "^1.57.0",
    "adm-zip": "^0.5.18",
    "pdf-parse": "^2.4.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.10.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.13"
  }
}
