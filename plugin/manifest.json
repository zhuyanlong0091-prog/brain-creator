{
  "name": "brain-creator",
  "version": "2.1.0",
  "description": "Agent-native testing brain for Claude Code and Codex.",
  "mcpServers": {
    "brain-creator": {
      "command": "npx",
      "args": ["brain-creator-mcp"],
      "env": {
        "BRAIN_CREATOR_WORKSPACE": ".",
        "BRAIN_CREATOR_TOOL_PROFILE": "facade",
        "BRAIN_CREATOR_AGENT_PROVIDER": "auto",
        "BRAIN_CREATOR_AGENT_TIMEOUT_MS": "120000"
      }
    }
  },
  "skills": [
    {
      "name": "brain-creator",
      "path": "skills/brain-creator/SKILL.md",
      "description": "One-sentence Brain Creator workflow entrypoint."
    }
  ],
  "doctor": {
    "command": "npx",
    "args": ["brain-creator-doctor"]
  }
}
