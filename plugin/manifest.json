{
  "name": "brain-creator",
  "version": "2.0.0",
  "description": "Agent-native testing brain for Claude Code and Codex.",
  "mcpServers": {
    "brain-creator": {
      "command": "brain-creator-mcp",
      "env": {
        "BRAIN_CREATOR_WORKSPACE": ".",
        "BRAIN_CREATOR_AGENT_COMMAND": "claude",
        "BRAIN_CREATOR_AGENT_ARGS": "[\"--print\",\"--permission-mode\",\"acceptEdits\"]",
        "BRAIN_CREATOR_AGENT_TIMEOUT_MS": "120000"
      }
    }
  },
  "skills": [
    {
      "name": "brain-creator",
      "path": "skills/brain-creator/SKILL.md",
      "description": "One-sentence Brain Creator workflow entrypoint."
    }
  ],
  "doctor": {
    "command": "brain-creator-doctor"
  }
}
